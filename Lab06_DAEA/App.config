<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      GOTCHA App.config (Lab 06):
      ConfigurationManager lee el App.config del ejecutable de inicio (este proyecto WPF).
      Si la cadena vive solo en Lab06_DAEA.Datos, en runtime no se encuentra.

      Cambiar "Data Source" segun el motor instalado:
        LocalDB            -> (localdb)\MSSQLLocalDB
        SQL Server Express -> .\SQLEXPRESS
        Instancia local    -> .
    -->
    <add name="NeptunoDB"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=NeptunoDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=15"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
