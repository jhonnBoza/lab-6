<Window x:Class="Lab06_DAEA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vistas="clr-namespace:Lab06_DAEA.Vistas"
        Title="Sistema de mantenimiento"
        Height="780" Width="1300"
        MinHeight="640" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Lienzo}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <DockPanel>

        <Border DockPanel.Dock="Top" Background="{StaticResource Superficie}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,0,0,1"
                Padding="24,0" Height="54">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="3" Height="16" CornerRadius="2"
                        Background="{StaticResource Acento}" Margin="0,0,12,0" />
                <TextBlock Text="SISTEMA DE MANTENIMIENTO"
                           VerticalAlignment="Center"
                           FontSize="12.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Tinta}" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Superficie}"
                BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Padding="24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource Acento}"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="TextoConexion" Style="{StaticResource Pie}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Style="{StaticResource Pie}"
                           Text="Class Library · DataSet · async/await" />
            </Grid>
        </Border>

        <TabControl x:Name="Navegacion"
                    TabStripPlacement="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    SelectionChanged="AlCambiarModulo">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource ItemNavegacion}" />
            </TabControl.Resources>

            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="188" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Superficie}"
                                BorderBrush="{StaticResource Borde}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="MODULOS"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource TintaTenue}"
                                           Margin="18,20,0,10" />
                                <TabPanel IsItemsHost="True" VerticalAlignment="Top" />
                            </DockPanel>
                        </Border>

                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Column="1"
                                          Margin="20"
                                          ContentSource="SelectedContent" />
                    </Grid>
                </ControlTemplate>
            </TabControl.Template>

            <TabItem Header="Productos">
                <vistas:ProductosView />
            </TabItem>
            <TabItem Header="Categorias">
                <vistas:CategoriasView />
            </TabItem>
            <TabItem Header="Proveedores">
                <vistas:ProveedoresView />
            </TabItem>
            <TabItem Header="Pedidos">
                <vistas:PedidosView />
            </TabItem>
            <TabItem Header="Reportes">
                <vistas:ReportesView />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
