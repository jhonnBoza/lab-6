<UserControl x:Class="Lab06_DAEA.Vistas.ProductosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Loaded="AlCargar">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Productos" Style="{StaticResource Titulo}" />

                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="FiltroTexto" Grid.Column="0" Margin="0"
                             TextChanged="AlCambiarFiltro"
                             ToolTip="Filtra por nombre, categoria o proveedor" />

                    <CheckBox x:Name="MostrarInactivos" Grid.Column="2"
                              Content="Mostrar dados de baja"
                              VerticalAlignment="Center" Margin="0"
                              ToolTip="Por defecto el listado solo trae los registros con Activo = 1"
                              Checked="AlCambiarVisibilidad" Unchecked="AlCambiarVisibilidad" />

                    <Button Grid.Column="4" Content="Actualizar"
                            Style="{StaticResource BotonSecundario}"
                            Click="AlActualizarLista" Margin="0" />
                </Grid>

                <TextBlock x:Name="TextoEstado" DockPanel.Dock="Bottom"
                           Style="{StaticResource Pie}" Margin="0,12,0,0" />

                <DataGrid x:Name="GrillaProductos" SelectionChanged="AlSeleccionarProducto"
                          RowStyle="{StaticResource FilaConEstado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"        Binding="{Binding IdProducto}"      Width="50" />
                        <DataGridTextColumn Header="PRODUCTO"  Binding="{Binding NombreProducto}"  Width="1.9*" />
                        <DataGridTextColumn Header="CATEGORIA" Binding="{Binding NombreCategoria}" Width="1.1*" />
                        <DataGridTextColumn Header="PROVEEDOR" Binding="{Binding NombreProveedor}" Width="1.5*" />
                        <DataGridTextColumn Header="PRECIO"    Binding="{Binding PrecioUnidad, StringFormat={}{0:N2}}" Width="75" />
                        <DataGridTextColumn Header="STOCK"     Binding="{Binding UnidadesEnExistencia}" Width="60" />
                        <DataGridTextColumn Header="ESTADO"    Binding="{Binding EstadoTexto}"     Width="105" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
            <DockPanel>
                <TextBlock x:Name="TextoModo" DockPanel.Dock="Top"
                           Style="{StaticResource TituloPanel}" Text="NUEVO PRODUCTO" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <WrapPanel>
                        <Button Content="Guardar" Style="{StaticResource BotonPrimario}"   Click="AlGuardar" Margin="0,0,8,8" />
                        <Button Content="Nuevo"   Style="{StaticResource BotonSecundario}" Click="AlNuevo" Margin="0,0,8,8" />
                        <Button x:Name="BotonEliminar" Content="Dar de baja"
                                Style="{StaticResource BotonPeligro}"
                                ToolTip="Eliminacion logica: pone Activo = 0, no borra la fila"
                                Click="AlEliminar" IsEnabled="False" Margin="0,0,8,8" />
                        <Button x:Name="BotonRestaurar" Content="Restaurar"
                                Style="{StaticResource BotonSecundario}"
                                ToolTip="Deshace la baja: vuelve a poner Activo = 1"
                                Click="AlRestaurar" IsEnabled="False" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Identificador" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoId" IsReadOnly="True" Text="(automatico)" />

                        <TextBlock Text="Nombre" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoNombre" MaxLength="80" />

                        <TextBlock Text="Categoria" Style="{StaticResource Etiqueta}" />
                        <ComboBox x:Name="ComboCategorias" DisplayMemberPath="NombreCategoria"
                                  SelectedValuePath="IdCategoria" />

                        <TextBlock Text="Proveedor" Style="{StaticResource Etiqueta}" />
                        <ComboBox x:Name="ComboProveedores" DisplayMemberPath="NombreCompania"
                                  SelectedValuePath="IdProveedor" />

                        <TextBlock Text="Cantidad por unidad" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoCantidadPorUnidad" MaxLength="40" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Precio" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoPrecio" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="En existencia" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoExistencia" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="En pedido" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoEnPedido" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Nivel de reposicion" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoNivelPedido" />
                            </StackPanel>
                        </Grid>

                        <CheckBox x:Name="CampoSuspendido" Content="Suspendido" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
