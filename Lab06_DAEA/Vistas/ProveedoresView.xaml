<UserControl x:Class="Lab06_DAEA.Vistas.ProveedoresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI"
             Loaded="AlCargar">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource Tarjeta}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Proveedores" Style="{StaticResource Titulo}" />

                <Border DockPanel.Dock="Top" Style="{StaticResource Bandeja}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Contacto" Style="{StaticResource Etiqueta}" />
                            <TextBox x:Name="FiltroContacto" Margin="0" KeyDown="AlPresionarTeclaFiltro" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ciudad" Style="{StaticResource Etiqueta}" />
                            <TextBox x:Name="FiltroCiudad" Margin="0" KeyDown="AlPresionarTeclaFiltro" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <CheckBox x:Name="MostrarInactivos"
                                      Content="Mostrar dados de baja"
                                      VerticalAlignment="Center" Margin="0,0,14,7"
                                      ToolTip="Por defecto la busqueda solo trae los proveedores con Activo = 1"
                                      Checked="AlCambiarVisibilidad" Unchecked="AlCambiarVisibilidad" />
                            <Button Content="Buscar"  Style="{StaticResource BotonPrimario}"   Click="AlBuscar" />
                            <Button Content="Limpiar" Style="{StaticResource BotonSecundario}" Click="AlLimpiarFiltros" Margin="0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock x:Name="TextoEstado" DockPanel.Dock="Bottom"
                           Style="{StaticResource Pie}" Margin="0,12,0,0" />

                <DataGrid x:Name="GrillaProveedores" SelectionChanged="AlSeleccionarProveedor"
                          RowStyle="{StaticResource FilaConEstado}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"       Binding="{Binding IdProveedor}"    Width="50" />
                        <DataGridTextColumn Header="COMPANIA" Binding="{Binding NombreCompania}" Width="1.7*" />
                        <DataGridTextColumn Header="CONTACTO" Binding="{Binding NombreContacto}" Width="1.3*" />
                        <DataGridTextColumn Header="CIUDAD"   Binding="{Binding Ciudad}"         Width="105" />
                        <DataGridTextColumn Header="PAIS"     Binding="{Binding Pais}"           Width="85" />
                        <DataGridTextColumn Header="TELEFONO" Binding="{Binding Telefono}"       Width="112" />
                        <DataGridTextColumn Header="ESTADO"   Binding="{Binding EstadoTexto}"    Width="105" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Tarjeta}">
            <DockPanel>
                <TextBlock x:Name="TextoModo" DockPanel.Dock="Top"
                           Style="{StaticResource TituloPanel}" Text="NUEVO PROVEEDOR" />

                <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                    <WrapPanel>
                        <Button Content="Guardar" Style="{StaticResource BotonPrimario}"   Click="AlGuardar" Margin="0,0,8,8" />
                        <Button Content="Nuevo"   Style="{StaticResource BotonSecundario}" Click="AlNuevo" Margin="0,0,8,8" />
                        <Button x:Name="BotonEliminar" Content="Dar de baja"
                                Style="{StaticResource BotonPeligro}"
                                ToolTip="Eliminacion logica: pone Activo = 0, no borra la fila"
                                Click="AlEliminar" IsEnabled="False" Margin="0,0,8,8" />
                        <Button x:Name="BotonRestaurar" Content="Restaurar"
                                Style="{StaticResource BotonSecundario}"
                                ToolTip="Deshace la baja: vuelve a poner Activo = 1"
                                Click="AlRestaurar" IsEnabled="False" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Identificador" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoId" IsReadOnly="True" Text="(automatico)" />

                        <TextBlock Text="Compania" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoCompania" MaxLength="60" />

                        <TextBlock Text="Contacto" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoContacto" MaxLength="60" />

                        <TextBlock Text="Cargo" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoCargo" MaxLength="60" />

                        <TextBlock Text="Direccion" Style="{StaticResource Etiqueta}" />
                        <TextBox x:Name="CampoDireccion" MaxLength="120" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Ciudad" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoCiudad" MaxLength="50" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Region" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoRegion" MaxLength="50" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cod. postal" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoCodPostal" MaxLength="15" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Pais" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoPais" MaxLength="50" />
                            </StackPanel>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Telefono" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoTelefono" MaxLength="30" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fax" Style="{StaticResource Etiqueta}" />
                                <TextBox x:Name="CampoFax" MaxLength="30" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
